 ER ev3_lcd_draw_string(const char *str, int32_t x, int32_t y) {
-// TODO: #41 temporary comment out
-//	bitmap_draw_string(str, lcd_screen, x, y, fonts[default_font], ROP_COPY);
+	int32_t line;
+
+	(void)x;
+
+	if (str == NULL) {
+		return E_PAR;
+	}
+
+	line = y / ATHRILL_LCD_CONSOLE_LINE_HEIGHT;
+	if ((line < 0) || (line >= ATHRILL_LCD_CONSOLE_LINES)) {
+		return E_PAR;
+	}
+
+	if (strncmp(
+		    athrill_lcd_console[line],
+		    str,
+		    ATHRILL_LCD_CONSOLE_TEXT_MAX
+		    ) != 0) {
+	  snprintf(
+		   athrill_lcd_console[line],
+		   ATHRILL_LCD_CONSOLE_TEXT_MAX,
+		   "%s",
+		   str
+		   );
+	  printf("%s\n", athrill_lcd_console[line]);
+	}
+
 	return E_OK;
 }
 
